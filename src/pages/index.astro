---
// Component Imports
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Socials from '../components/Socials.astro';
import Hero from '../components/Hero.astro';

// Style Imports
import '../styles/global.css';
import '../styles/typography.css';
---

<Layout title="Natural Selection Design" navColor="blue">
	<main>
		<Hero />
		<section>
			<div>
				<img src="../../images/home-hero.png" alt="" style="display:none;">
				<h2 class="header__body">
					we’re small And we like to keep it that way 
				</h2>
				<p class="small-body desc__body">
					We’re small enough to remain nimble yet experienced enough to pack a punch.
					<br>
					We combine strategic effort with personal attention you can expect from a collaboration
					that’s enthusiastic about creating something memorable and distinctly yours.
				</p>
				<div>
					<h3>
						Brands We've<br> Worked With
					</h3>
					<div class="small-body clients__grid">
						<div>
							<p>Lucky Me! Noodles</p>
							<div></div>
							<p>SkyFlakes Crackers</p>
							<div></div>
							<p>Fita Crackers</p>
							<div></div>
						</div>
	
						<div>
							<p>Food Industries, Inc.</p>
							<div></div>
							<p>Unilab</p>
							<div></div>
							<p>Century Pacific</p>
							<div></div>
						</div>
	
						<div>
							<p>Hueza Bakery</p>
							<div></div>
							<p>Future Fresh</p>
							<div></div>
							<p>Khao Khai Thai Chicken House</p>
						</div>

						<div>
							<p>Palm Tree Abbey </p>
							<div></div>
							<p>Maker and Made Cafe</p>
							<div></div>
							<p>Maxine’s Nut Butters</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<CTA />
		<Socials />
	</main>
</Layout>

<style>
	section {
		background-color: var(--blue);
		
		> div {
			display: flex;
			flex-direction: column;
			padding: 16px 24px 32px 24px;
			align-items: center;
			justify-items: center;
			text-align: center;
			color: var(--off-white);
			margin: auto;
			gap: 24px;
			
			@media (width >=768px) {
				padding: 80px;
				gap: 48px;
				max-width: var(--max-width);
			}

			> h2 {
				font-size: var(--h3);

				@media (width >=1280px) {
					font-size: var(--h2);
				} 
			}

			> img {
				max-width: 100%;
			}

			> p {
				line-height: 140% !important;
				width: auto;

				@media (width >=1280px) {
					width: 800px;
				} 
			}
	
			> div {
				display: flex;
				flex-direction: column;
				gap: 24px;
				width: 100%;
				margin-top: 24px;

				> h3 > br {
					@media (width >= 426px) {
						display: none;
					}
				}
	
				> div {
					display: grid;
					grid-template-columns: repeat(1, 1fr);
					gap: 8px;
					
					@media (width >=1280px) {
						grid-template-columns: repeat(4, minmax(0,1fr));
						gap: 40px;
					}
	
					> div{
						display: flex;
						flex-direction: column;
						gap: 8px;
						text-align: left;
	
						> div{
							border: solid 1px var(--off-white);
							opacity: 0.3;
						}

						> div:nth-of-type(3) {
							@media (width >=1280px) {
								display: none;
							}
						}
					}
				}
			}
		}
	}

	.header__body {
		max-width: 900px;
	}
	.desc__body {
		max-width: 650px;
	}
</style>

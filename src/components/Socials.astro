---
// Style imports
import '../styles/global.css';
import '../styles/typography.css';
---

<section>
    <div>
        <h2 class="h2-italic">Keep Up With us on Socials</h2>
        <p class="small-body">Every now and then we post our latest projects on our Instragram account. You can also keep in touch with us here!</p>
        <a href="https://www.instagram.com/nsdesign.ph/?hl=en" target="_blank" class="socials__grid">
            <img src="/images/sumo.jpg" alt="">
            <img src="/images/skyflakes.jpg" alt="">
            <img src="/images/fita.jpg" alt="">
            <img src="/images/future-fresh.jpg" alt="">
        </a>
    </div>
</section>

<style>
    section {
        background-color: var(--orange);
        overflow: hidden;

        > div {
            display: flex;
            flex-direction: column;
            gap: 32px;
            align-items: center;
            text-align: center;
            color: var(--off-white);
            max-width: var(--max-width);
			margin: auto;
            padding: 56px 24px;

            @media (width >=1280px) {
                padding: 56px 24px;
            }

            > h2 {
                font-size: var(--h3);

                @media (width >=1280px) {
                    font-size: var(--h2);
                }
            }
        }
    }

    .socials__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 20px;
        margin-top: 20px;

        @media (width > 431px) {
            width: 120vw;
            grid-template-columns: repeat(4, minmax(0,1fr));
            gap: 32px;
        }
    }
    img {
        width: 100%;
        height: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        transition: transform 0.2s ease-in-out;
    }
    img:hover {
        transform: translateY(-5px);
    }
</style>
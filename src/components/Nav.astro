---
// Style imports
import '../styles/global.css';
import '../styles/typography.css';

// Component imports
import Link from './Link.astro';
import Button from './Button.astro';
import SecondaryLogo from './SecondaryLogo.astro';

// Props
interface Props {
    color: "blue" | "off-white";
}

const {
    color
} = Astro.props as Props;
---

{
    color === "blue" && (
    <nav class="navbar blue">
        <ul>
            <li>
                <a href="/">
                    <SecondaryLogo size="small" type="acronym"/>    
                </a>
            </li>
            <li>
                <Button 
                    color="whiteToBlue"
                    href="/contact/"
                    isUppercase={true}
                    text="Contact Us"
                />
            </li>
            <li class="hamburger-blue" id="hamburger">
                <div></div>
                <div></div>
                <div></div>
            </li>   
        </ul>
    </nav>
    )
}

{
    color === "off-white" && (
    <nav class="navbar off-white">
        <ul>
            <li>
                <a href="/">
                    <SecondaryLogo size="small" type="acronym"/>    
                </a>
            </li>
            <li>
                <Button 
                    color="black"
                    href="/contact/"
                    isUppercase={true}
                    text="Contact Us"
                />
            </li>
            <li class="hamburger-offWhite" id="hamburger">
                <div></div>
                <div></div>
                <div></div>
            </li>   
        </ul>
    </nav>
    )
}

<script>
    //@ts-nocheck
    var prevScrollpos = window.scrollY;
    window.onscroll = function() {
    var currentScrollPos = window.scrollY;
    if (prevScrollpos > currentScrollPos) {
        // User is scrolling up
        document.querySelector(".navbar").classList.remove("hide-navbar");
    } else {
        // User is scrolling down
        document.querySelector(".navbar").classList.add("hide-navbar");
    }
    prevScrollpos = currentScrollPos;
}
</script>

<style>
    nav {
        display: flex;
        justify-content: center;

        > ul {
            padding: 10px 20px;
            display: flex;
            justify-content: space-between;
            width: 100%;

            @media (width >= 768px) {
                padding: 40px 80px;
            }

            @media (width >= 1024px) {
                padding: 10px 120px;
                max-width: 1680px;
            }

            > li {
                justify-self: center;
                align-self: center;
            }

            li:nth-of-type(1) {
                @media (width >= 1024px) {
                    justify-self: start;
                }
            }
            
            > li:nth-of-type(3)  {
                justify-self: start;

                @media (width >= 1024px) {
                    justify-self: center;
                }
            }

            li:nth-of-type(5) {
                @media (width >= 1024px) {
                    justify-self: end;
                }
            }

            > li:nth-of-type(6)  {
                display: flex;
                flex-direction: column;
                gap: 8px;
                justify-self:end;

                @media (width >= 1024px) {
                    display: none;
                }

                > div {
                    width: 55px;
                    height: 4px;
                    transition: var(--transition);
                }
            }
        }
    }

    .hamburger-blue {
        > div {
            background-color: var(--off-white);
        }
    }


    .hamburger-offWhite {
        > div {
            background-color: var(--black);
        }
    }

    .navbar {
        transition: var(--transition);
        position: fixed;
        top: 0;
        left: 25;
        width: 100%;
        z-index: 98;
    }

    .blue {
        background-color: var(--blue);
    }

    .off-white {
        background-color: var(--off-white);
    }

    .hide-navbar {
        transform: translateY(-100%);
    }

    #hamburger {
        display: none;
    }
</style>